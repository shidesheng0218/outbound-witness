{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outbound Witness",
  "version": "0.2.0",
  "identifier": "org.outboundwitness.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Outbound Witness",
        "width": 900,
        "height": 720,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.svg"]
  }
}
