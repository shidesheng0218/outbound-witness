[
  {
    "route": "anthropic",
    "upstream_host": "api.anthropic.com",
    "upstream_port": 443,
    "header": "x-api-key",
    "secret_env": "ANTHROPIC_API_KEY",
    "note": "来源一：代理容器环境变量。agent 调用 http://proxy:8080/anthropic/v1/messages"
  },
  {
    "route": "openai",
    "upstream_host": "api.openai.com",
    "upstream_port": 443,
    "header": "authorization",
    "secret_env": "OPENAI_AUTH_HEADER",
    "note": "注入整段头部值时，把值本身（含 Bearer 前缀）放进环境变量"
  },
  {
    "route": "cloud",
    "upstream_host": "api.example-cloud.test",
    "upstream_port": 443,
    "header": "authorization",
    "secret_file": "credentials/cloud",
    "token_command": ["sh", "-c", "printf 'Bearer %s' \"$CLOUD_TOKEN\""],
    "note": "来源二：会话启动时在宿主机执行 token_command，输出写入 credentials/cloud（0600），agent 拿不到"
  }
]
