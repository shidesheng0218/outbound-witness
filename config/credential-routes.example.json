[
  {
    "route": "anthropic",
    "upstream_host": "api.anthropic.com",
    "upstream_port": 443,
    "header": "x-api-key",
    "secret_env": "ANTHROPIC_API_KEY",
    "note": "agent 调用 http://proxy:8080/anthropic/v1/messages，密钥只在代理容器内解析"
  },
  {
    "route": "openai",
    "upstream_host": "api.openai.com",
    "upstream_port": 443,
    "header": "authorization",
    "secret_env": "OPENAI_AUTH_HEADER",
    "note": "注入整段头部值时，请把值本身（含 Bearer 前缀）放进环境变量"
  }
]
